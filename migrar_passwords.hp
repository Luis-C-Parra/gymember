<?php
// Conexión a tu BD
$conn = new mysqli("localhost", "root", "", "gymember_db");

if ($conn->connect_error) {
    die("Conexión fallida: " . $conn->connect_error);
}

// 1. Obtener todos los usuarios
$sql = "SELECT id, contrasena FROM usuarios"; 
$result = $conn->query($sql);

if (!$result) {
    die("Error en la consulta: " . $conn->error); // Esto te dirá si la tabla no existe
}

if ($result->num_rows > 0) {
    while($row = $result->fetch_assoc()) {
        $id = $row['id'];
        $pass_plana = $row['contrasena'];

        // 2. Hashear la contraseña con el estándar de PHP
        $hash = password_hash($pass_plana, PASSWORD_DEFAULT);

        // 3. Actualizar la base de datos
        $update = $conn->prepare("UPDATE usuarios SET contrasena = ? WHERE id = ?");
        $update->bind_param("si", $hash, $id);
        $update->execute();
        
        echo "Usuario ID $id actualizado.<br>";
    }
}
$conn->close();
?>